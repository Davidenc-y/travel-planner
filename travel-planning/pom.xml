<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.travel.planner</groupId>
        <artifactId>travel-planner</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <groupId>com.travel.planning</groupId>
    <artifactId>travel-planning</artifactId>
    <packaging>jar</packaging>

    <name>travel-planning</name>
    <description>核心规划模块：Agent + StateGraph + 工具 + Controller</description>

    <dependencies>
        <!-- 内部依赖：travel-common -->
        <dependency>
            <groupId>com.travel.common</groupId>
            <artifactId>travel-common</artifactId>
        </dependency>
        <!-- M6-6-R1 Step 0：聊天流中立模块（StreamingPipeline/端口/payload 映射） -->
        <dependency>
            <groupId>com.travel.chatstream</groupId>
            <artifactId>travel-chat-stream</artifactId>
        </dependency>
        <!-- M6-31：聊天领域中立模块（ChatService 九步流水线/Agent/记忆/防护/仓储） -->
        <dependency>
            <groupId>com.travel.domain</groupId>
            <artifactId>travel-chat-domain</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Actuator（健康检查） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring AOP（F89 Agent 追溯切面） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- MyBatis Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Redis（F13/F67：refresh token、会话摘要 TTL 用 spring-data-redis） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- MinIO（图片存储） -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>

        <!-- Apache POI（导出行程文档，可选） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <!-- Hutool -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <!-- X-1b：Nacos 配置中心（版本随 SCA 2025.0.0.0 BOM；白名单四件之一；
             NACOS_ENABLED=false 时禁用解析器跳过 import，行为与引入前零差异） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- X-2a：Nacos 服务发现（版本随 SCA BOM；白名单四件之二；
             NACOS_ENABLED=false 时 @ConditionalOnNacosDiscoveryEnabled 不装配=零注册零发现） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- Y-2a：Sentinel 限流（版本随 SCA BOM；Y 批白名单三件之一；crawl 不加。
             E-33：主闸 spring.cloud.sentinel.enabled 默认 false=starter 全链路不初始化字节等价） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>

        <!-- Y-2c：Sentinel 规则 Nacos 数据源（版本随 SCA BOM；Y 批白名单三件之二。
             未灌配 dataId=无规则=全放行零行为；r1：namespace/group 显式写在 yml datasource 节内） -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-datasource-nacos</artifactId>
        </dependency>

        <!-- Y-3b：事件总线 rabbit 通道（版本随 SC 2025.0.3 BOM；Y 批白名单三件之三。
             E-33：travel.eventbus.type=redis（默认）时 RabbitEventBusConfig 零装配，
             binder 无 binding 配置=惰性；health.rabbit 显式默认关（r1）） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-stream-rabbit</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
