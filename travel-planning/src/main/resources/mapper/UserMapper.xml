<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travel.planning.repository.UserMapper">

    <select id="findByUsername" resultType="com.travel.common.entity.User">
        SELECT * FROM t_user WHERE username = #{username} AND deleted = 0
    </select>

    <!-- M5-1：按邮箱查询用户（绑定邮箱唯一性校验） -->
    <select id="findByEmail" resultType="com.travel.common.entity.User">
        SELECT * FROM t_user WHERE email = #{email} AND deleted = 0 LIMIT 1
    </select>
</mapper>
