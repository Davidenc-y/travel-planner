<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travel.planning.repository.DataQualityMapper">

    <!-- outbox 未消费计数（consumed=0，DG-3b 写入 / DG-3c 消费置 1）。 -->
    <select id="countEtlOutboxUnconsumed" resultType="long">
        SELECT COUNT(*) FROM t_etl_outbox WHERE consumed = 0
    </select>

    <!-- outbox 全量计数。 -->
    <select id="countEtlOutboxTotal" resultType="long">
        SELECT COUNT(*) FROM t_etl_outbox
    </select>
</mapper>
