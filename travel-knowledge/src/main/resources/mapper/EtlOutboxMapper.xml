<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travel.knowledge.repository.EtlOutboxMapper">

    <!-- DG-3c-fix：事件消费成功后将该景点未消费事件标记 consumed=1（PD-1 断言①；幂等只标未消费行） -->
    <update id="markConsumed">
        UPDATE t_etl_outbox SET consumed = 1 WHERE attraction_id = #{attractionId} AND consumed = 0
    </update>
</mapper>
