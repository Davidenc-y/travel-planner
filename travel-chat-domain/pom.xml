<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.travel.planner</groupId>
        <artifactId>travel-planner</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <groupId>com.travel.domain</groupId>
    <artifactId>travel-chat-domain</artifactId>
    <packaging>jar</packaging>

    <name>travel-chat-domain</name>
    <description>M6-31 聊天领域中立模块：ChatService 九步流水线/Agent/记忆/防护/追溯/仓储。
        不引入任何 Web Starter，供 MVC（travel-planning）传输层共用同一业务域（U 批 webflux 双传输退役后单传输）</description>

    <dependencies>
        <!-- 中立流式端口与 payload 映射（无 Web Starter） -->
        <dependency>
            <groupId>com.travel.chatstream</groupId>
            <artifactId>travel-chat-stream</artifactId>
        </dependency>
        <!-- M10-2a：源码直接引用 com.travel.common.*（实体/ErrorCode/工具），
             显式声明避免经 chat-stream 隐式传递依赖 -->
        <dependency>
            <groupId>com.travel.common</groupId>
            <artifactId>travel-common</artifactId>
        </dependency>
        <!-- E-19①/E-26：会话记忆存储域物理抽取（V1 同包搬运；D-4c/d/e 迁移消费方经此依赖可见） -->
        <dependency>
            <groupId>com.travel.memory</groupId>
            <artifactId>travel-memory</artifactId>
        </dependency>

        <!-- M7：模型网关（注册表/工厂/路由代理；内含 DashScope/OpenAI 核心 SDK） -->
        <dependency>
            <groupId>com.travel.aigateway</groupId>
            <artifactId>travel-ai-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-agent-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-graph-core</artifactId>
        </dependency>

        <!-- Spring Cloud OpenFeign + LoadBalancer（KnowledgeClient 调用 knowledge 模块） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- X-7a：Redisson core（白名单四件之四；独立 Redisson.create 实例，
             travel.lock.redisson.enabled=false 默认关=不装配零行为，E-33；
             禁 redisson-spring-boot-starter 入模块） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
        </dependency>

        <!-- MyBatis Plus + MySQL（会话/消息/幂等/追溯仓储） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Redis（会话摘要/短时记忆） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- AOP（TraceAspect 追溯切面） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- AiModelConfig 显式使用 RestClient/WebClient：仅 spring-web/spring-webflux 类库，
             不引入任何 Web Starter 自动配置，避免 MVC/WebFlux 双栈冲突 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
