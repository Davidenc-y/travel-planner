<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travel.planning.repository.TravelProfileMapper">

    <select id="findByUserId" resultType="com.travel.common.entity.TravelProfile">
        SELECT * FROM t_travel_profile WHERE user_id = #{userId}
