<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.travel.planner</groupId>
        <artifactId>travel-planner</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <groupId>com.travel.aigateway</groupId>
    <artifactId>travel-ai-gateway</artifactId>
    <packaging>jar</packaging>

    <name>travel-ai-gateway</name>
    <description>M7 模型调度模块：模型注册表（单一事实源）+ ChatModel 工厂（Provider 差异吸收）
        + RoleRoutingChatModel 路由代理（@Primary/lightModel 语义兼容）；零 Web 栈，
        不引任何 starter 自动配置激活（openai 用核心库手工构建）</description>

    <dependencies>
        <!-- M10-2c：复用 travel-core CircuitBreaker.Registry 做模型维度熔断 -->
        <dependency>
            <groupId>com.travel.core</groupId>
            <artifactId>travel-core</artifactId>
        </dependency>
        <!-- Spring Boot 基础（仅配置/DI 能力，非 Web 栈） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- AI-3a/AR-3：预算闸可选 Redis 层（StringRedisTemplate 经 ObjectProvider 弱耦合；
            optional=不向下游传递，运行时自动配置激活面零变化=E-33；同 artifact 已在 common/planning 在用） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- DashScope 核心 SDK（非 starter，避免自动配置；版本由父 pom 管理） -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-dashscope</artifactId>
        </dependency>
        <!-- OpenAI 兼容 SDK（DeepSeek/GLM/DashScope 兼容端点；版本由父 pom 管理） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
